# Supabase — same project as the mobile app (Indeez MVP).
# URL + anon key are public by design (they ship in the mobile binary);
# the anon key is only safe because every table is behind RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never expose to the browser and never
# prefix with NEXT_PUBLIC_. Only needed if/when a server route must act as
# the service role.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin. Used for auth redirect URLs, metadata, link previews,
# robots.txt, sitemap.xml and the Organization structured data, so a wrong
# value here advertises the wrong host to search engines.
#
# Leave it UNSET in production: it falls back to https://indeez.world, which
# is correct. Only set it locally, or on a preview that should advertise its
# own URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
